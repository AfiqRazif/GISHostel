{
  "entities": {
    "Room": {
      "title": "Room",
      "description": "A hostel bed slot or room unit at Apartment Desa Jati 2 or Nilai Square.",
      "type": "object",
      "properties": {
        "roomId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique room and bed slot identifier, e.g. DJ2-A-04-B1"
        },
        "location": {
          "type": "string",
          "enum": ["Apartment Desa Jati 2", "Nilai Square"],
          "maxLength": 64,
          "description": "Hostel complex location"
        },
        "block": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "description": "Block identifier"
        },
        "unitNo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "description": "Unit or apartment number"
        },
        "bedSlot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "description": "Bed slot label, e.g. B1, B1-Window, Upper-1"
        },
        "monthlyRate": {
          "type": "number",
          "description": "Monthly rental rate in RM"
        },
        "status": {
          "type": "string",
          "enum": ["Vacant", "Occupied", "Maintenance", "Reserved / Blocked"],
          "maxLength": 32,
          "description": "Current occupancy, exclusive block, or maintenance status"
        },
        "currentStudentId": {
          "type": "string",
          "maxLength": 64,
          "description": "Nullable Matrix or IC number of currently occupying resident"
        },
        "currentStudentName": {
          "type": "string",
          "maxLength": 120,
          "description": "Nullable full name of currently occupying resident"
        },
        "statusNote": {
          "type": "string",
          "maxLength": 160,
          "description": "Optional note such as Exclusive Unit resident attribution"
        },
        "exclusiveResidentId": {
          "type": "string",
          "maxLength": 64,
          "description": "Nullable residentId who holds whole-unit exclusive lock on this bed"
        },
        "updatedBy": {
          "type": "string",
          "maxLength": 160,
          "description": "Email of the staff member who last wrote to this document"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the last write"
        }
      },
      "required": [
        "roomId",
        "location",
        "block",
        "unitNo",
        "bedSlot",
        "monthlyRate",
        "status",
        "currentStudentId",
        "currentStudentName",
        "updatedBy",
        "updatedAt"
      ]
    },
    "Student": {
      "title": "Student",
      "description": "A GIS Nilai hostel resident record (Student, Lecturer/Staff, or Guest).",
      "type": "object",
      "properties": {
        "studentId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Primary identifier (Matrix, Staff ID, or IC No.)"
        },
        "fullName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "Resident full name"
        },
        "residentType": {
          "type": "string",
          "enum": ["Student", "Lecturer / Staff", "Guest"],
          "maxLength": 32,
          "description": "Classification of hostel resident"
        },
        "occupancyMode": {
          "type": "string",
          "enum": ["Single Bed", "Whole Unit Exclusive"],
          "maxLength": 32,
          "description": "Single bed or whole-unit exclusive occupancy"
        },
        "phone": {
          "type": "string",
          "minLength": 6,
          "maxLength": 32,
          "description": "Resident contact phone number"
        },
        "emergencyContact": {
          "type": "string",
          "minLength": 6,
          "maxLength": 120,
          "description": "Guardian or emergency contact details"
        },
        "program": {
          "type": "string",
          "enum": ["Diploma", "SKM", "DiFFER", "Other"],
          "maxLength": 32,
          "description": "Academic program or department"
        },
        "assignedRoomId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Assigned roomId from the rooms collection"
        },
        "hostelLocation": {
          "type": "string",
          "enum": ["Apartment Desa Jati 2", "Nilai Square"],
          "maxLength": 64,
          "description": "Hostel complex of the assigned room"
        },
        "checkInDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "maxLength": 10,
          "description": "Check-in date YYYY-MM-DD"
        },
        "checkOutDate": {
          "type": "string",
          "maxLength": 10,
          "description": "Nullable check-out date YYYY-MM-DD"
        },
        "depositPaid": {
          "type": "number",
          "description": "Hostel security deposit paid in RM"
        },
        "standardRoomRate": {
          "type": "number",
          "description": "Standard room monthly rate in RM"
        },
        "monthlyRebate": {
          "type": "number",
          "description": "Recurring monthly rebate in RM"
        },
        "rebateReason": {
          "type": "string",
          "maxLength": 64,
          "description": "Reason for monthly rebate"
        },
        "effectiveMonthlyFee": {
          "type": "number",
          "description": "Net monthly rent fee after rebate in RM"
        },
        "monthlyFee": {
          "type": "number",
          "description": "Net monthly rental fee in RM"
        },
        "firstMonthCharge": {
          "type": "number",
          "description": "First month prorated charge in RM (auto-halved after 15th unless edited)"
        },
        "firstMonthNote": {
          "type": "string",
          "maxLength": 64,
          "description": "Note describing first month rate rule or leniency"
        },
        "status": {
          "type": "string",
          "enum": ["Active", "Checked-Out", "Suspended"],
          "maxLength": 32,
          "description": "Residency status"
        },
        "updatedBy": {
          "type": "string",
          "maxLength": 160,
          "description": "Email of the staff member who last wrote to this document"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the last write"
        }
      },
      "required": [
        "studentId",
        "fullName",
        "residentType",
        "occupancyMode",
        "phone",
        "emergencyContact",
        "program",
        "assignedRoomId",
        "hostelLocation",
        "checkInDate",
        "checkOutDate",
        "depositPaid",
        "standardRoomRate",
        "monthlyRebate",
        "rebateReason",
        "effectiveMonthlyFee",
        "monthlyFee",
        "status",
        "updatedBy",
        "updatedAt"
      ]
    },
    "Payment": {
      "title": "Payment",
      "description": "A hostel fee, deposit, rebate waiver, or refund transaction.",
      "type": "object",
      "properties": {
        "paymentId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique payment document identifier"
        },
        "receiptNo": {
          "type": "string",
          "minLength": 3,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Official receipt number formatted GIS-YYYYMM-XXXX"
        },
        "studentId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Referenced studentId"
        },
        "studentName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "Resident full name at time of payment"
        },
        "roomId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Referenced roomId"
        },
        "hostelLocation": {
          "type": "string",
          "enum": ["Apartment Desa Jati 2", "Nilai Square"],
          "maxLength": 64,
          "description": "Hostel complex"
        },
        "billingMonth": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}$",
          "maxLength": 7,
          "description": "Billing month YYYY-MM"
        },
        "paymentType": {
          "type": "string",
          "enum": [
            "Monthly Rent",
            "Registration/Deposit",
            "Utility/Penalty",
            "Rebate / Fee Waiver",
            "Deposit Refund"
          ],
          "maxLength": 48,
          "description": "Category of transaction"
        },
        "amount": {
          "type": "number",
          "description": "Amount in RM"
        },
        "paymentMethod": {
          "type": "string",
          "enum": [
            "DuitNow QR",
            "Online Transfer",
            "Cash",
            "PTPTN/Sponsor",
            "Internal Adjustment",
            "Historical Migration"
          ],
          "maxLength": 48,
          "description": "Payment channel used"
        },
        "bankRefNo": {
          "type": "string",
          "maxLength": 64,
          "description": "Bank or receipt reference number"
        },
        "paymentDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "maxLength": 10,
          "description": "Payment date YYYY-MM-DD"
        },
        "status": {
          "type": "string",
          "enum": ["Paid", "Pending", "Overdue", "Waived"],
          "maxLength": 32,
          "description": "Payment settlement status"
        },
        "notes": {
          "type": "string",
          "maxLength": 240,
          "description": "Optional staff remarks"
        },
        "proofImageData": {
          "type": "string",
          "description": "Compressed Base64 JPEG data URL of uploaded payment proof"
        },
        "physicalReceiptStatus": {
          "type": "string",
          "enum": ["Pending Issuance", "Issued"],
          "maxLength": 32,
          "description": "Physical receipt book issuance tracking status"
        },
        "physicalReceiptNo": {
          "type": "string",
          "maxLength": 64,
          "description": "Optional physical receipt book serial number"
        },
        "receiptIssuedBy": {
          "type": "string",
          "maxLength": 160,
          "description": "Email of staff member who issued the physical receipt"
        },
        "receiptIssuedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when physical receipt was issued"
        },
        "recordedBy": {
          "type": "string",
          "maxLength": 160,
          "description": "Email of the staff member who recorded the payment"
        },
        "recordedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when payment was recorded"
        },
        "updatedBy": {
          "type": "string",
          "maxLength": 160,
          "description": "Email of the staff member who last wrote to this document"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the last write"
        }
      },
      "required": [
        "paymentId",
        "receiptNo",
        "studentId",
        "studentName",
        "roomId",
        "hostelLocation",
        "billingMonth",
        "paymentType",
        "amount",
        "paymentMethod",
        "bankRefNo",
        "paymentDate",
        "status",
        "notes",
        "recordedBy",
        "recordedAt",
        "updatedBy",
        "updatedAt"
      ]
    },
    "StaffProfile": {
      "title": "StaffProfile",
      "description": "Authenticated GIS hostel staff profile and role metadata.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["staff", "admin"],
          "maxLength": 16
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "displayName", "role", "updatedAt"]
    },
    "StaffUser": {
      "title": "StaffUser",
      "description": "GIS hostel portal staff account managed by Master Admin.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "username": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "fullName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["Master Admin", "Admin", "Staff"],
          "maxLength": 32
        },
        "active": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "username", "email", "fullName", "role", "active", "createdAt"]
    }
  },
  "firestore": {
    "/rooms/{roomId}": {
      "schema": { "$ref": "#/entities/Room" },
      "description": "Hostel room and bed slot inventory across Apartment Desa Jati 2 and Nilai Square."
    },
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "GIS Nilai hostel resident records keyed by Matrix/Staff/IC studentId."
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/Payment" },
      "description": "Hostel rent, deposit, rebate waiver, and refund ledger records."
    },
    "/staff/{uid}": {
      "schema": { "$ref": "#/entities/StaffProfile" },
      "description": "GIS staff profiles isolated per authenticated UID."
    },
    "/staff_users/{uid}": {
      "schema": { "$ref": "#/entities/StaffUser" },
      "description": "Managed GIS staff user accounts with Master Admin RBAC and active toggle."
    }
  }
}
