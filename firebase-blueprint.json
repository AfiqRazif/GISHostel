{
  "entities": {
    "Room": {
      "title": "Room",
      "description": "A hostel bed slot or room unit at Apartment Desa Jati 2 or Nilai Square.",
      "type": "object",
      "properties": {
        "roomId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique room and bed slot identifier, e.g. DJ2-A-04-B1"
        },
        "location": {
          "type": "string",
          "enum": ["Apartment Desa Jati 2", "Nilai Square"],
          "maxLength": 64,
          "description": "Hostel complex location"
        },
        "block": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "description": "Block identifier"
        },
        "unitNo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "description": "Unit or apartment number"
        },
        "bedSlot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "description": "Bed slot label, e.g. B1"
        },
        "monthlyRate": {
          "type": "number",
          "description": "Monthly rental rate in RM"
        },
        "status": {
          "type": "string",
          "enum": ["Vacant", "Occupied", "Maintenance"],
          "maxLength": 32,
          "description": "Current occupancy or maintenance status"
        },
        "currentStudentId": {
          "type": "string",
          "maxLength": 64,
          "description": "Nullable Matrix or IC number of currently occupying student"
        },
        "currentStudentName": {
          "type": "string",
          "maxLength": 120,
          "description": "Nullable full name of currently occupying student"
        },
        "updatedBy": {
          "type": "string",
          "maxLength": 160,
          "description": "Email of the staff member who last wrote to this document"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the last write"
        }
      },
      "required": [
        "roomId",
        "location",
        "block",
        "unitNo",
        "bedSlot",
        "monthlyRate",
        "status",
        "currentStudentId",
        "currentStudentName",
        "updatedBy",
        "updatedAt"
      ]
    },
    "Student": {
      "title": "Student",
      "description": "A GIS Nilai student hostel resident record.",
      "type": "object",
      "properties": {
        "studentId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Primary identifier (Matrix or IC No.)"
        },
        "fullName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "Student full name"
        },
        "phone": {
          "type": "string",
          "minLength": 6,
          "maxLength": 32,
          "description": "Student contact phone number"
        },
        "emergencyContact": {
          "type": "string",
          "minLength": 6,
          "maxLength": 120,
          "description": "Guardian or emergency contact details"
        },
        "program": {
          "type": "string",
          "enum": ["Diploma", "SKM", "DiFFER", "Other"],
          "maxLength": 32,
          "description": "Academic program"
        },
        "assignedRoomId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Assigned roomId from the rooms collection"
        },
        "hostelLocation": {
          "type": "string",
          "enum": ["Apartment Desa Jati 2", "Nilai Square"],
          "maxLength": 64,
          "description": "Hostel complex of the assigned room"
        },
        "checkInDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "maxLength": 10,
          "description": "Check-in date YYYY-MM-DD"
        },
        "checkOutDate": {
          "type": "string",
          "maxLength": 10,
          "description": "Nullable check-out date YYYY-MM-DD"
        },
        "depositPaid": {
          "type": "number",
          "description": "Hostel deposit paid in RM"
        },
        "monthlyFee": {
          "type": "number",
          "description": "Monthly rental fee in RM"
        },
        "status": {
          "type": "string",
          "enum": ["Active", "Checked-Out", "Suspended"],
          "maxLength": 32,
          "description": "Residency status"
        },
        "updatedBy": {
          "type": "string",
          "maxLength": 160,
          "description": "Email of the staff member who last wrote to this document"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the last write"
        }
      },
      "required": [
        "studentId",
        "fullName",
        "phone",
        "emergencyContact",
        "program",
        "assignedRoomId",
        "hostelLocation",
        "checkInDate",
        "checkOutDate",
        "depositPaid",
        "monthlyFee",
        "status",
        "updatedBy",
        "updatedAt"
      ]
    },
    "Payment": {
      "title": "Payment",
      "description": "A hostel fee, deposit, or utility payment transaction.",
      "type": "object",
      "properties": {
        "paymentId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique payment receipt identifier"
        },
        "studentId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Referenced studentId"
        },
        "studentName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "Student full name at time of payment"
        },
        "roomId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Referenced roomId"
        },
        "hostelLocation": {
          "type": "string",
          "enum": ["Apartment Desa Jati 2", "Nilai Square"],
          "maxLength": 64,
          "description": "Hostel complex"
        },
        "billingMonth": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}$",
          "maxLength": 7,
          "description": "Billing month YYYY-MM"
        },
        "paymentType": {
          "type": "string",
          "enum": ["Monthly Rent", "Hostel Deposit", "Utility / Misc", "Refund"],
          "maxLength": 32,
          "description": "Category of payment"
        },
        "amount": {
          "type": "number",
          "description": "Amount in RM"
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["Online Transfer (FPX/DuitNow)", "Cash", "JomPAY", "Card"],
          "maxLength": 48,
          "description": "Payment channel used"
        },
        "referenceNo": {
          "type": "string",
          "maxLength": 64,
          "description": "Bank or receipt reference number"
        },
        "paymentDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "maxLength": 10,
          "description": "Payment date YYYY-MM-DD"
        },
        "status": {
          "type": "string",
          "enum": ["Paid", "Pending", "Overdue", "Waived"],
          "maxLength": 32,
          "description": "Payment settlement status"
        },
        "notes": {
          "type": "string",
          "maxLength": 240,
          "description": "Optional staff remarks"
        },
        "updatedBy": {
          "type": "string",
          "maxLength": 160,
          "description": "Email of the staff member who last wrote to this document"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the last write"
        }
      },
      "required": [
        "paymentId",
        "studentId",
        "studentName",
        "roomId",
        "hostelLocation",
        "billingMonth",
        "paymentType",
        "amount",
        "paymentMethod",
        "referenceNo",
        "paymentDate",
        "status",
        "notes",
        "updatedBy",
        "updatedAt"
      ]
    },
    "StaffProfile": {
      "title": "StaffProfile",
      "description": "Authenticated GIS hostel staff profile and role metadata.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["staff", "admin"],
          "maxLength": 16
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "displayName", "role", "updatedAt"]
    }
  },
  "firestore": {
    "/rooms/{roomId}": {
      "schema": { "$ref": "#/entities/Room" },
      "description": "Hostel room and bed slot inventory across Apartment Desa Jati 2 and Nilai Square."
    },
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "GIS Nilai student residency records keyed by Matrix/IC studentId."
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/Payment" },
      "description": "Hostel rent, deposit, and fee ledger records."
    },
    "/staff/{uid}": {
      "schema": { "$ref": "#/entities/StaffProfile" },
      "description": "GIS staff profiles isolated per authenticated UID."
    }
  }
}
